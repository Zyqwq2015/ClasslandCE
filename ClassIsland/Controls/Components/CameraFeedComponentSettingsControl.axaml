<controls:ComponentBase x:TypeArguments="componentSettings:CameraFeedComponentSettings"
                        x:Class="ClassIsland.Controls.Components.CameraFeedComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
                        xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        mc:Ignorable="d"
                        d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:CameraFeedComponentSettingsControl}}">
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE71E;}"
                                        Header="摄像头设备索引"
                                        Description="0 为第一台摄像头，1 为第二台，以此类推。">
                <controls1:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.DeviceIndex}"
                                   Minimum="0" Maximum="10" Increment="1" FormatString="F0" Width="120"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE7B4;}"
                                        Header="镜像显示"
                                        Description="画面左右镜像，适合摄像头在屏幕上方的情况。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Mirrored, Mode=TwoWay}"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>