<controls:ComponentBase x:TypeArguments="componentSettings:VolumeLevelComponentSettings"
                        x:Class="ClassIsland.Controls.Components.VolumeLevelComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
                        xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        mc:Ignorable="d"
                        d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:VolumeLevelComponentSettingsControl}}">
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE767;}"
                                        Header="拾音灵敏度"
                                        Description="越高越容易检测到微弱声音。">
                <controls1:SettingsExpander.Footer>
                    <Slider Width="200" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.Sensitivity}"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B7;}"
                                        Header="麦克风设备索引"
                                        Description="默认 0 即系统默认麦克风。">
                <controls1:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.DeviceIndex}"
                                   Minimum="0" Maximum="10" Increment="1" FormatString="F0" Width="120"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>