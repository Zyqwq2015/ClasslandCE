<controls:ComponentBase x:TypeArguments="componentSettings:PomodoroComponentSettings"
                        x:Class="ClassIsland.Controls.Components.PomodoroComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
                        xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        mc:Ignorable="d"
                        d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Classes="component-settings-container animated-intro"
                    DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:PomodoroComponentSettingsControl}}">
            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE823;}"
                                        Header="工作时长(分钟)"
                                        Description="一个番茄的工作时间。">
                <controls1:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.WorkMinutes}"
                                   Minimum="1" Maximum="120" Increment="1" FormatString="F0" Width="150"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE895;}"
                                        Header="休息时长(分钟)"
                                        Description="番茄结束后的休息时间。">
                <controls1:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.BreakMinutes}"
                                   Minimum="1" Maximum="120" Increment="1" FormatString="F0" Width="150"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>

            <controls1:SettingsExpander IconSource="{ci:FluentIconSource &#xE8F5;}"
                                        Header="自动开始下一阶段"
                                        Description="当前阶段结束后自动开始下一阶段。">
                <controls1:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoStartNext, Mode=TwoWay}"/>
                </controls1:SettingsExpander.Footer>
            </controls1:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>