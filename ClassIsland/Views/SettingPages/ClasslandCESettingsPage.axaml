<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.ClasslandCESettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:abstraction="clr-namespace:ClassIsland.Platforms.Abstraction;assembly=ClassIsland.Platforms.Abstractions"
      mc:Ignorable="d" 
      Design.Width="960" Design.Height="500"
      Loaded="ClasslandCESettingsPage_OnLoaded"
      Unloaded="ClasslandCESettingsPage_OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <!-- ===== CE 标识 ===== -->
            <controls1:IconText Glyph="&#xE8CA;" Text="Classland CE 增强功能" Margin="0 0 0 4" />
            <TextBlock Text="基于 ClassIsland 的社区增强版，新增语音助手、播报模板、快速建课等功能。"
                       Margin="16 0 0 8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

            <!-- ===== 1. 语音助手 ===== -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE8CA;}" 
                                        Header="语音助手（离线语音操控）"
                                        Description="说「课表助手」唤醒，可查询课表、时间、打开应用等。">
                <controls3:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsVoiceAssistantEnabled, Mode=TwoWay}"/>
                </controls3:SettingsExpander.Footer>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE342;}" 
                                        Header="开机自启"
                                        Description="系统启动时自动运行 Classland CE。">
                <controls3:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsAutoStartEnabled, Mode=TwoWay}"/>
                </controls3:SettingsExpander.Footer>
            </controls3:SettingsExpander>

            <!-- ===== 2. 播报模板 ===== -->
            <controls1:IconText Glyph="&#xE02B;" Text="语音播报模板" Margin="0 16 0 4" />

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE1AC;}" 
                                        Header="播报模板"
                                        Description="支持占位符：{subject} {teacher} {startTime} {endTime} {location} {subjectIndex}">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <TextBlock Text="选择预设模板：" />
                    <ItemsControl ItemsSource="{Binding ViewModel.SpeechTemplatePresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Margin="4"
                                        Classes="accent"
                                        Command="{Binding $parent[StackPanel].DataContext.ViewModel.ApplyTemplatePresetCommand}"
                                        CommandParameter="{Binding $parent[ItemsControl].ItemIndex}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding ViewModel.SettingsService.Settings.CeSpeechTemplate, Mode=TwoWay}"
                             MinHeight="60"
                             TextWrapping="Wrap"
                             Watermark="输入自定义播报模板…" />
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- 重复播报 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE1AC;}" 
                                        Header="重复播报"
                                        Description="在课前/课后播报结束后，间隔一段时间再次播报">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsRepeatSpeechEnabled, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding ViewModel.SettingsService.Settings.CeIsRepeatSpeechEnabled}">
                        <TextBlock VerticalAlignment="Center">间隔</TextBlock>
                        <NumericUpDown Value="{Binding ViewModel.SettingsService.Settings.CeRepeatSpeechIntervalSeconds}"
                                       Minimum="5" Maximum="300" FormatString="F0" Width="100" />
                        <TextBlock VerticalAlignment="Center">秒，最多</TextBlock>
                        <NumericUpDown Value="{Binding ViewModel.SettingsService.Settings.CeRepeatSpeechMaxCount}"
                                       Minimum="1" Maximum="20" FormatString="F0" Width="60" />
                        <TextBlock VerticalAlignment="Center">次</TextBlock>
                    </StackPanel>
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- 试听播报 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE02B;}" 
                                        Header="试听播报"
                                        Description="点击按钮试听当前播报模板效果。">
                <StackPanel Spacing="8" Margin="0 8 0 8" Orientation="Horizontal">
                    <TextBox Text="{Binding ViewModel.TestSpeechText}"
                             Watermark="输入测试文字…"
                             Width="300" />
                    <Button Content="试听"
                            Command="{Binding ViewModel.TestSpeechCommand}" />
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- ===== 3. 快速时间表生成 ===== -->
            <controls1:IconText Glyph="&#xE304;" Text="快速时间表生成" Margin="0 16 0 4" />

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE304;}" 
                                        Header="一键生成时间表"
                                        Description="根据参数快速生成标准时间表，并添加到课表档案中。">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">第一节课</TextBlock>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <NumericUpDown Value="{Binding ViewModel.SettingsService.Settings.CeQuickTimeLayoutStartHour}"
                                           Minimum="0" Maximum="23" FormatString="F0" Width="60" />
                            <TextBlock VerticalAlignment="Center">时</TextBlock>
                            <NumericUpDown Value="{Binding ViewModel.SettingsService.Settings.CeQuickTimeLayoutStartMinute}"
                                           Minimum="0" Maximum="59" FormatString="F0" Width="60" />
                            <TextBlock VerticalAlignment="Center">分</TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">每节时长</TextBlock>
                        <NumericUpDown Grid.Row="0" Grid.Column="3"
                                       Value="{Binding ViewModel.SettingsService.Settings.CeQuickTimeLayoutDurationMinutes}"
                                       Minimum="10" Maximum="180" FormatString="F0" Width="80" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">课间休息</TextBlock>
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding ViewModel.SettingsService.Settings.CeQuickTimeLayoutBreakMinutes}"
                                       Minimum="0" Maximum="120" FormatString="F0" Width="80" />
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">每天节数</TextBlock>
                        <NumericUpDown Grid.Row="1" Grid.Column="3"
                                       Value="{Binding ViewModel.SettingsService.Settings.CeQuickTimeLayoutClassCount}"
                                       Minimum="1" Maximum="16" FormatString="F0" Width="80" />
                    </Grid>
                    <Button Content="生成时间表"
                            Command="{Binding ViewModel.GenerateQuickTimeLayoutCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- ===== 3.5 深度主题定制 ===== -->
            <controls1:IconText Glyph="&#xE7F4;" Text="深度主题定制" Margin="0 16 0 4" />
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE7F4;}"
                                        Header="深度主题定制"
                                        Description="勾选后立即把 Windows 桌面壁纸换成 ClassIsland CE 专属壁纸；取消勾选则还原原壁纸。">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsDeepThemeCustomization, Mode=TwoWay}" />
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- ===== 3.6 桌面组件 ===== -->
            <controls1:IconText Glyph="&#xE7B8;" Text="桌面组件（壁纸浮动小组件）" Margin="0 16 0 4" />
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE7B8;}"
                                        Header="启用桌面组件层"
                                        Description="在 Windows 桌面上叠加一层透明组件层，可放置时间沙漏、课件快捷方式、番茄时钟等小组件，跟随桌面显示。">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsDesktopWidgetsEnabled, Mode=TwoWay}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        启用后：桌面上的小组件可直接点击交互（例如课件快捷方式一键打开课件）。
                    </TextBlock>
                </StackPanel>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE70F;}"
                                        Header="桌面组件编辑模式"
                                        Description="开启后桌面组件显示边框和控制点，可拖拽移动、拖角缩放、右键删除/添加组件。">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsDesktopWidgetsEditMode, Mode=TwoWay}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        编辑时：
                        · 拖动组件移动位置
                        · 拖动 8 个角/边控制点缩放
                        · 双击组件打开设置
                        · 右键空白处添加组件、删除所选组件
                    </TextBlock>
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- ===== 4. 构建与部署 ===== -->
            <controls1:IconText Glyph="&#xE342;" Text="便携版构建" Margin="0 16 0 4" />
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE342;}" 
                                        Header="免装 .NET 便携版"
                                        Description="Classland CE 支持一键构建自包含（self-contained）版，无需安装 .NET 运行时即可运行，适合 U 盘携带。">
                <StackPanel Spacing="4" Margin="0 8 0 8">
                    <TextBlock TextWrapping="Wrap">
                        使用以下命令在项目根目录构建：
                    </TextBlock>
                    <SelectableTextBlock TextWrapping="Wrap"
                                         FontFamily="Consolas, monospace"
                                         Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                         Padding="8">
./build-ce.ps1 -SelfContained
                    </SelectableTextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0 4 0 0">
                        或在 Visual Studio 中直接以 Release 配置编译。
                    </TextBlock>
                </StackPanel>
            </controls3:SettingsExpander>

            <!-- ===== 5. 关于 CE ===== -->
            <controls1:IconText Glyph="&#xE946;" Text="关于 Classland CE" Margin="0 16 0 4" />
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE946;}" 
                                        Header="版本信息"
                                        Description="Classland CE = ClassIsland Community Edition，基于上游 ClassIsland 项目。">
                <StackPanel Spacing="4" Margin="0 8 0 8">
                    <TextBlock>基于 ClassIsland master 分支（GPLv3）</TextBlock>
                    <TextBlock>CE 增强功能：语音助手、播报模板、快速时间表生成、便携构建</TextBlock>
                    <HyperlinkButton Content="上游项目 https://github.com/ClassIsland/ClassIsland"
                                     NavigateUri="https://github.com/ClassIsland/ClassIsland" />
                </StackPanel>
            </controls3:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>