<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.VoiceControlSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d"
      Design.Width="960" Design.Height="500"
      Loaded="VoiceControlSettingsPage_OnLoaded"
      Unloaded="VoiceControlSettingsPage_OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls1:IconText Glyph="&#xE720;" Text="语音唤醒控制" Margin="0 0 0 4" />

            <!-- 运行状态：诊断信息实时展示，未启用/启动失败原因一眼可见 -->
            <Border CornerRadius="6" Padding="12" Margin="0 0 0 8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="运行状态" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ViewModel.Status.StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </Border>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE720;}"
                                        Header="启用语音唤醒控制"
                                        Description="说唤醒词「小课小课」后说出指令，可控制桌面、启动应用、调节音量等。重启/关机等高危操作需二次确认。">
                <controls3:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeIsVoiceControlEnabled, Mode=TwoWay}"/>
                </controls3:SettingsExpander.Footer>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE720;}"
                                        Header="唤醒词"
                                        Description="自定义唤醒词（修改后需重启应用生效）。离线 Whisper 按文字匹配，中文词开箱即用。">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <TextBox Text="{Binding ViewModel.SettingsService.Settings.CeVoiceWakeWord, Mode=TwoWay}"
                             Watermark="小课小课" Width="240" />
                </StackPanel>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B6;}"
                                        Header="Whisper 模型路径"
                                        Description="离线中文识别模型（ggml 格式）。留空则使用程序目录 Models/ggml-model.bin。需自行下载，例如 ggml-small.bin 或量化版 ggml-small-q5_0.bin（中文推荐 small 及以上）。">
                <StackPanel Spacing="8" Margin="0 8 0 8">
                    <TextBox Text="{Binding ViewModel.SettingsService.Settings.CeVoiceWhisperModelPath, Mode=TwoWay}"
                             Watermark="Models\ggml-model.bin" Width="420" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                        下载地址（任选其一，放到上述路径）：&#10;ggml-small.bin：huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin&#10;ggml-small-q5_0.bin（更小更快）：huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small-q5_0.bin
                    </TextBlock>
                </StackPanel>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE9E9;}"
                                        Header="唤醒灵敏度"
                                        Description="数值越高越灵敏，但也更容易误触发。">
                <StackPanel Spacing="8" Margin="0 8 0 8" Orientation="Horizontal">
                    <Slider Value="{Binding ViewModel.SettingsService.Settings.CeVoiceSensitivity, Mode=TwoWay}"
                            Minimum="0" Maximum="1" Width="240" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding ViewModel.SettingsService.Settings.CeVoiceSensitivity, StringFormat={}{0:P0}}" />
                </StackPanel>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE945;}"
                                        Header="低功耗模式"
                                        Description="降低识别频率，节省 CPU（唤醒响应略慢）。">
                <controls3:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.CeVoiceLowPowerMode, Mode=TwoWay}"/>
                </controls3:SettingsExpander.Footer>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE74A;}"
                                        Header="唤醒灵敏度（高级）"
                                        Description="仅影响 VAD 对「是否有人在说话」的判断：数值越高越灵敏、越易触发，也更容易把环境噪声误判为语音。离线 Whisper 主要按文字匹配唤醒词，此值对最终唤醒影响有限。">
                <StackPanel Spacing="8" Margin="0 8 0 8" Orientation="Horizontal">
                    <Slider Value="{Binding ViewModel.SettingsService.Settings.CeVoiceSensitivity, Mode=TwoWay}"
                            Minimum="0" Maximum="1" Width="240" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding ViewModel.SettingsService.Settings.CeVoiceSensitivity, StringFormat={}{0:P0}}" />
                </StackPanel>
            </controls3:SettingsExpander>

            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0 12 0 0">
                提示：本方案为纯离线识别，无需联网、无需安装 Windows 语音识别语言包、无需训练模型。只需把 Whisper 的 ggml 模型放入 Models/ 目录，并保证系统默认麦克风可用即可。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
